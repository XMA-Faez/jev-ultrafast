# One key is enough: an OpenRouter key routes Jev decisions through OpenRouter's Decisions API
# and also pays for the TYPE_TEXT helper.
OPENROUTER_API_KEY=

# Optional: call TypeSafe directly for decisions (takes precedence over OpenRouter).
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Optional text-helper overrides. Any OpenAI-compatible endpoint works; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# Optional runtime settings.
# JEV_TRACE_DIR=artifacts/traces
# JEV_HEADLESS=1
# JEV_PROFILE_DIR=~/.local/share/jev/profile
# JEV_CHROME_PATH=chromium
